# Optional. If set, the "claude-reasoner-01" provider calls the real
# Claude API for its views. If unset, it uses a deterministic
# mean-reversion fallback so the demo still runs fully offline.
ANTHROPIC_API_KEY=

# Optional. Overrides where the exchange's SQLite files + synthetic
# market get written. Defaults to ./data relative to the repo root.
OTD_DATA_DIR=
